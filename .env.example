# Runtime uses the pooled URL. Prisma migrations use the direct URL.
DATABASE_URL="postgresql://portfolio_scope:portfolio_scope@localhost:5432/portfolio_scope?schema=public"
DIRECT_URL="postgresql://portfolio_scope:portfolio_scope@localhost:5432/portfolio_scope?schema=public"

# Public, environment-specific application origin.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stable identity for the deterministic, publicly accessible demo dataset.
DEMO_USER_EMAIL="demo@portfolioscope.dev"

# Optional initial error monitoring. Leave blank to disable Sentry locally.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="local"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="local"
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
