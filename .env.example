# Runtime uses the pooled URL. Prisma migrations use the direct URL.
DATABASE_URL="postgresql://portfolio_scope:portfolio_scope@localhost:5432/portfolio_scope?schema=public"
DIRECT_URL="postgresql://portfolio_scope:portfolio_scope@localhost:5432/portfolio_scope?schema=public"

# Public, environment-specific application origin.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js uses a high-entropy secret to protect cookies and OAuth state.
# Generate a real local value and store it only in the ignored .env file.
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Canonical Auth.js origin for local callbacks. Use HTTPS in Production.
AUTH_URL="http://localhost:3000"

# Guarded localhost-only disposable database identity for manual validation.
# Rejected unless NEXT_PUBLIC_APP_URL is an HTTP loopback origin and VERCEL_ENV
# is neither preview nor production. Keep false outside the validation window.
LOCAL_DISPOSABLE_AUTH_ENABLED="false"

# Create separate OAuth applications/clients for local, Preview, and Production.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GOOGLE_ENABLED="false"

# Stable identity for the deterministic, publicly accessible demo dataset.
DEMO_USER_EMAIL="demo@portfolioscope.dev"

# SEC EDGAR requires an identifying application name and monitored contact.
SEC_USER_AGENT="PortfolioScope/1.0"
SEC_CONTACT_EMAIL=""

# Private Cloudflare R2 bucket used only by server-side SEC ingestion.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Optional S3-compatible endpoint override; the account endpoint is derived when blank.
R2_ENDPOINT=""

# Localhost-only escape hatch for one-at-a-time manual M14 validation. Never set
# this in Preview or Production; it is rejected there even if set accidentally.
SEC_LOCAL_MANUAL_INGESTION_ENABLED="false"

# M15 ephemeral coordination and signed background delivery. Keep all three
# feature flags false until Redis, QStash, the public origin, migrations, and
# signed worker callbacks have been verified in the target environment.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
QSTASH_TOKEN=""
QSTASH_URL=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# Required only for protected Vercel Preview deployments. Server-only.
VERCEL_AUTOMATION_BYPASS_SECRET=""
BACKGROUND_JOBS_ENABLED="false"
SEC_INGESTION_ENABLED="false"
PUBLIC_STOCK_PAGES_ENABLED="false"
RESEARCH_GENERATION_ENABLED="false"
AI_RESEARCH_ENABLED="false"
EARNINGS_SYNC_ENABLED="false"
PORTFOLIO_EXPORT_ENABLED="false"
MAINTENANCE_MODE="false"

# M26 EarningsAPI.com activation is Production-only and fail-closed. Keep the
# flag false until the migration, Redis daily claims, bounded 25-symbol provider
# contract check, cache permission, and quota monitoring have been verified.
# The key is server-only and must never use a NEXT_PUBLIC_ prefix.
EARNINGS_API_KEY=""

# M27 external research remains fail-closed outside an approved environment.
# Keep AI_RESEARCH_ENABLED=false until
# migrations, signed jobs, SEC provenance, provider billing alerts, and the
# limits below have been verified there. The checked-in model is the pinned
# Preview candidate. OPENAI_API_KEY is server-only and must never use a
# NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=""
OPENAI_RESEARCH_MODEL="gpt-5.4-mini-2026-03-17"
AI_MONTHLY_BUDGET_USD="5"
AI_USER_MONTHLY_BUDGET_USD="1"
AI_MAX_COST_PER_JOB_USD="0.25"
AI_MAX_TOKENS_PER_JOB="50000"
AI_MAX_OUTPUT_TOKENS_PER_CALL="1500"
AI_PROVIDER_TIMEOUT_MS="20000"
AI_USER_MONTHLY_REPORT_LIMIT="5"

# Optional error monitoring. Keep the release values identical for server and client.
# Tracing defaults to zero and should remain sampled conservatively on the free tier.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="local"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="local"
SENTRY_RELEASE=""
NEXT_PUBLIC_SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE="0"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0"
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Optional privacy-safe product analytics. Both values are required to enable it.
# Use the regional PostHog ingestion host assigned to the project.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# Secret Better Stack heartbeat URLs. Configure HTTPS URLs only in Production.
BETTER_STACK_WORKER_HEARTBEAT_URL=""
BETTER_STACK_BACKUP_HEARTBEAT_URL=""
BETTER_STACK_BACKUP_FAILURE_HEARTBEAT_URL=""

# Operator-recorded recovery evidence shown only in admin diagnostics.
LAST_RESTORE_DRILL_AT=""
LAST_RESTORE_DRILL_REFERENCE=""
LAST_COST_REVIEW_AT=""
LAST_COST_REVIEW_REFERENCE=""
