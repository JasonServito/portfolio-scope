# Runtime uses the pooled URL. Prisma migrations use the direct URL.
DATABASE_URL="postgresql://portfolio_scope:portfolio_scope@localhost:5432/portfolio_scope?schema=public"
DIRECT_URL="postgresql://portfolio_scope:portfolio_scope@localhost:5432/portfolio_scope?schema=public"

# Public, environment-specific application origin.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js uses a high-entropy secret to protect cookies and OAuth state.
# Generate a real local value and store it only in the ignored .env file.
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Canonical Auth.js origin for local callbacks. Use HTTPS in Production.
AUTH_URL="http://localhost:3000"

# Guarded localhost-only disposable database identity for manual validation.
# Rejected unless NEXT_PUBLIC_APP_URL is an HTTP loopback origin and VERCEL_ENV
# is neither preview nor production. Keep false outside the validation window.
LOCAL_DISPOSABLE_AUTH_ENABLED="false"

# Create separate OAuth applications/clients for local, Preview, and Production.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stable identity for the deterministic, publicly accessible demo dataset.
DEMO_USER_EMAIL="demo@portfolioscope.dev"

# SEC EDGAR requires an identifying application name and monitored contact.
SEC_USER_AGENT="PortfolioScope/1.0"
SEC_CONTACT_EMAIL=""

# Private Cloudflare R2 bucket used only by server-side SEC ingestion.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Optional S3-compatible endpoint override; the account endpoint is derived when blank.
R2_ENDPOINT=""

# Localhost-only escape hatch for one-at-a-time manual M14 validation. Never set
# this in Preview or Production; it is rejected there even if set accidentally.
SEC_LOCAL_MANUAL_INGESTION_ENABLED="false"

# M15 ephemeral coordination and signed background delivery. Keep all three
# feature flags false until Redis, QStash, the public origin, migrations, and
# signed worker callbacks have been verified in the target environment.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
BACKGROUND_JOBS_ENABLED="false"
SEC_INGESTION_ENABLED="false"
RESEARCH_GENERATION_ENABLED="false"

# Optional initial error monitoring. Leave blank to disable Sentry locally.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="local"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="local"
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
