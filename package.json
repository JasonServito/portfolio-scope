{
  "name": "portfolio-scope",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "vitest run --pool=forks --maxWorkers=4 && npm run test:operations",
    "test:operations": "node --test scripts/backup-postgres.test.mjs scripts/restore-postgres.test.mjs",
    "test:integration": "node scripts/verify-demo-seed.mjs && node scripts/verify-auth-persistence.mjs && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "jobs:schedules": "node scripts/configure-qstash-schedules.mjs",
    "backup:postgres": "node scripts/backup-postgres.mjs",
    "restore:postgres": "node scripts/restore-postgres.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1087.0",
    "@base-ui/react": "^1.6.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.42.0",
    "@upstash/qstash": "^2.11.2",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "next": "^15.5.19",
    "next-auth": "^5.0.0-beta.31",
    "posthog-js": "^1.407.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.19",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
