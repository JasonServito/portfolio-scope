{
  "name": "portfolio-scope",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "vitest run --pool=forks --maxWorkers=4 && npm run test:operations",
    "test:operations": "node --test scripts/backup-postgres.test.mjs scripts/diagnose-postgres-connection.test.mjs scripts/restore-postgres.test.mjs scripts/guarded-prisma.test.mjs",
    "research:evaluate": "vite-node --config vitest.config.ts scripts/evaluate-research.ts",
    "test:integration": "node scripts/verify-demo-seed.mjs && node scripts/verify-auth-persistence.mjs && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "demo:capture": "node scripts/capture-recruiter-assets.mjs",
    "demo:vitals": "node scripts/measure-m17-web-vitals.mjs",
    "demo:request-paths": "node scripts/measure-m22-request-paths.mjs",
    "earnings:contract-check:approved": "vite-node scripts/run-earnings-api-contract-check.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:db": "npm run db:generate && prisma validate && npm run db:deploy",
    "verify:security": "npm audit --audit-level=high",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/guarded-prisma.mjs migrate-dev",
    "db:deploy": "node scripts/guarded-prisma.mjs migrate-deploy",
    "db:deploy:approved": "node scripts/guarded-prisma.mjs migrate-deploy --approved-remote",
    "db:seed": "node scripts/guarded-prisma.mjs seed",
    "db:seed:approved": "node scripts/guarded-prisma.mjs seed --approved-remote",
    "jobs:schedules": "node scripts/configure-qstash-schedules.mjs",
    "backup:postgres": "node scripts/backup-postgres.mjs",
    "restore:postgres": "node scripts/restore-postgres.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1096.0",
    "@base-ui/react": "^1.6.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.42.0",
    "@upstash/qstash": "^2.11.2",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "next": "^16.3.3",
    "next-auth": "^5.0.0-beta.31",
    "posthog-js": "^1.407.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
